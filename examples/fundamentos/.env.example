# Copia este archivo como .env (queda fuera de git) y pon tu API key de https://platform.claude.com
ANTHROPIC_API_KEY=

# Opcionales
# ANDES_MODEL=claude-sonnet-5-5         # modelo del agente (el mismo MODEL_ID de las lecciones)
# ANDES_MODEL_RAPIDO=claude-haiku-5-5   # juez de evals, sub-agentes y variante barata
# ANDES_FALLBACKS=0                     # desactiva el fallback del servidor ante un rechazo (refusal)
