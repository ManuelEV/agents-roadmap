    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shiki": "^4.6.0",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
